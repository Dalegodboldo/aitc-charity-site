# Copy this file to `.env.local` (which is git-ignored) and fill in real values.
# The dev server picks up changes to .env.local on its next start.

# Formspree form ID for the Team page contact form.
# 1. Sign in at https://formspree.io and create a new form (any name).
# 2. Formspree gives you a form endpoint like https://formspree.io/f/abc12345.
# 3. Copy the part after /f/ (in that example, "abc12345") into the line below.
# 4. Save .env.local, then restart the dev server.
NEXT_PUBLIC_FORMSPREE_ID=

# Anthropic API key for the site chatbot (/api/chat). Required for the
# floating chat bubble and the /chat page to work — without it, the
# route returns a 500 and the assistant cannot respond.
#
# Where to get it:
#   https://console.anthropic.com/settings/keys
# Production: set the same variable in Vercel → Project Settings → Environment Variables.
# IMPORTANT: this MUST stay server-side. Do not rename it with
# NEXT_PUBLIC_* — that would leak the key into the client bundle.
ANTHROPIC_API_KEY=
